source "https://rubygems.org"

# GitHub Pages builds with this gem, which bundles Jekyll plus every
# plugin/version GitHub Pages supports. Keeping everything on this
# gem is what makes "git push" alone enough to publish.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

# Windows/JRuby compatibility, harmless elsewhere
gem "wdm", "~> 0.1.1", :platforms => [:x64_mingw, :mingw]
